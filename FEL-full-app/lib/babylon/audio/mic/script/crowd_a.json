   "text": "Brick! Brick! Brick!"
  },
  {
   "id": "crowd.heckle.02",
   "moment": "crowd.heckle",
   "text": "Practice, my friend. Practice!"
  },
  {
   "id": "crowd.heckle.03",
   "moment": "crowd.heckle",
   "text": "Seen better at warm-ups!"
  },
  {
   "id": "crowd.idle.01",
