   "text": "There you go!"
  },
  {
   "id": "crowd.cheer.04",
   "moment": "crowd.cheer",
   "text": "Pretty! So pretty!"
  },
  {
   "id": "crowd.erupt.01",
   "moment": "crowd.erupt",
   "text": "I'm out of my seat!"
  },
  {
   "id": "crowd.erupt.02",
   "moment": "crowd.erupt",
   "text": "Twenty years, never that!"
  },
  {
   "id": "crowd.erupt.03",
   "moment": "crowd.erupt",
   "text": "That's why I come here!"
  },
  {
   "id": "crowd.erupt.04",
   "moment": "crowd.erupt",
   "text": "Tell me that was real!"
  },
  {
   "id": "crowd.groan.01",
