// EDU-05 motion lessons, phase B (2026-11-10): writes lib/motion-lesson/samples.data.ts — the preview's lesson files,
// built from the owner's own committed takes (lib/pose/__fixtures__) by lib/motion-lesson/sampleSpecs.ts.
//
//   npx tsx scripts/motion-lesson/build-samples.mts          write the file
//   npx tsx scripts/motion-lesson/build-samples.mts --check  write nothing; exit 1 if a lesson would not pass
//
// Run it again whenever the adapter changes (lib/motion-lesson/samples.test.ts says so when the data is stale).
import fs from 'node:fs';
import path from 'node:path';
import * as SpecsNs from '../../lib/motion-lesson/sampleSpecs';
import * as FormatNs from '../../lib/motion-lesson/format';
import * as SamplesNs from '../../lib/motion-lesson/samples';

// tsx loads these TypeScript modules as CommonJS from an .mts script: the named exports sit on the default
const S = ((SpecsNs as unknown as { default?: typeof SpecsNs }).default ?? SpecsNs);
const F = ((FormatNs as unknown as { default?: typeof FormatNs }).default ?? FormatNs);
const L = ((SamplesNs as unknown as { default?: typeof SamplesNs }).default ?? SamplesNs);

const ROOT = path.join(import.meta.dirname, '../..');
const lines: string[] = [];
let bad = 0;
for (const s of L.SAMPLE_LESSONS) {
  const take = JSON.parse(fs.readFileSync(path.join(ROOT, 'lib/pose/__fixtures__', `${S.SAMPLE_TAKES[s.id].fixture}.json`), 'utf8'));
  if (!/owner/i.test(take.source.license)) { console.error(`${s.id}: not the owner's own take (${take.source.license})`); bad++; continue; }
  const lesson = S.buildSampleLesson(s.id, take);
  const errors = F.lessonErrors(lesson);
  if (errors.length) { console.error(`${s.id}: ${errors.join(' | ')}`); bad++; continue; }
  const bytes = await F.encodeLesson(lesson);
  console.log(`${s.id.padEnd(10)} ${lesson.duration.toFixed(2)} s  ${String(lesson.keys.length).padStart(3)} keys  ${(bytes.byteLength / 1024).toFixed(2)} KB  ${F.kbPerMinute(bytes, lesson.duration).toFixed(1)} KB/min  phrases ${lesson.phrases.map((p) => `${p.label} ${p.from}–${p.to}`).join(', ')}  weak ${lesson.weak.length}`);
  lines.push(`  '${s.id}': '${Buffer.from(bytes).toString('base64')}',`);
}
if (bad) process.exit(1);
if (!process.argv.includes('--check')) {
  const out = `// GENERATED by scripts/motion-lesson/build-samples.mts from the owner's own takes (lib/pose/__fixtures__). Do not edit:\n// run the generator. Each value is a lesson file (lib/motion-lesson/format.ts), base64.\nexport const SAMPLE_DATA: Record<string, string> = {\n${lines.join('\n')}\n};\n`;
  fs.writeFileSync(path.join(ROOT, 'lib/motion-lesson/samples.data.ts'), out);
  console.log('wrote lib/motion-lesson/samples.data.ts');
}
