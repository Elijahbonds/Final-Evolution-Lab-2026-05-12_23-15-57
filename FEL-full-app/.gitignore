# Playwright capture output — large, reproducible via scripts/capture-dunk-reveal.mts
docs/shots/*/
!docs/shots/ref/

# Build output. `.next` is next's own default; every `NEXT_DIST_DIR=.next-<tag>` a
# parallel dev server or verification build uses lands beside it. None of it belongs
# in git, and leaving the variants untracked-but-not-ignored is how 43 GB of stale
# build cache hid in plain sight inside `git status` (2026-09-12 release pass).
.next
.next-*/
.next-*
scripts/avatar/out/

# Env files (2026-09-12 release pass). The only env rule in this tree lived in the
# repo-root .gitignore as `.env*.local`, which leaves `.env.production` tracked — and
# that is precisely the file a Next/Firebase deploy asks you to create, holding
# DATABASE_URL and NEXTAUTH_SECRET. One `git add -A` on deploy day and the database
# credentials are in the history. Everything but the documented example is ignored here.
.env
.env.*
!.env.example

# Never in the tree, whatever `git add` is fed (2026-09-22): the worktrees share ONE node_modules through a symlink,
# which git sees as an untracked file; shots/ is probe frames; .firebase/ is the deploy cache. A `git add -A` once
# swept 1,141 of these into a commit.
node_modules
/shots/
.firebase/
