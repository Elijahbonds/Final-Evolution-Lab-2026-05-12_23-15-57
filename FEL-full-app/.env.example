# FEL — environment variables. Copy to .env and fill in real values.
# There was no .env / .env.example in this repo before this pass — Prisma,
# NextAuth, and Stripe all fail at startup without one.

# --- Database (required) ---
DATABASE_URL="postgresql://user:password@localhost:5432/fel_dev"

# --- Auth (required) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 renamed these; harmless to set both while on v4.
# AUTH_SECRET=
# AUTH_TRUST_HOST=

# --- Stripe (required for payments/checkout/webhook routes) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_COINS_SMALL=""
STRIPE_PRICE_COINS_LARGE=""

# --- Object storage (asset uploads: closet items, creative cards, etc.) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# --- OAuth providers (optional; only needed if these sign-in methods ship) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# --- Misc integrations ---
ABACUSAI_API_KEY=""
CHALLENGE_SIGN_SECRET="generate-a-random-secret"
NEXUS_GATEWAY_URL=""
NOTIF_ID_COME_BACK_PLAY=""
NOTIF_ID_NEW_LEAD_CAPTURED=""
NOTIF_ID_REFERRAL_REWARD=""
NOTIF_ID_WELCOME_EMAIL=""

# --- Client-side feature flags (all optional; unset = feature default) ---
# NEXT_PUBLIC_DISABLE_3D=1              # kill-switch: force every mode back to Canvas 2D
# NEXT_PUBLIC_DUNK_FINISH_VARIETY=1
# NEXT_PUBLIC_MOCAP_DUNK=1
# NEXT_PUBLIC_NEXUS_ENABLED=1
# NEXT_PUBLIC_PLAYTEST_MODE=1
# NEXT_PUBLIC_PREMIUM_DRESSING=1
# NEXT_PUBLIC_PROCEDURAL_CHARACTERS=1
# NEXT_PUBLIC_PROCEDURAL_ENVIRONMENTS=1

# --- Controller Link (phone-as-controller, §6.5) ---
# REQUIRED IN PRODUCTION. Without these the signaling store falls back to an
# in-process Map, which is correct in dev and BROKEN on Vercel: each serverless
# invocation may land in a different isolate with its own empty Map, so a phone's
# answer is written to one instance and polled from another that never sees it.
# The join simply never completes. Any Upstash/Vercel-KV-compatible REST endpoint
# works — see lib/controller-link/kvSignalStore.ts.
CONTROLLER_LINK_KV_URL=""
CONTROLLER_LINK_KV_TOKEN=""

# --- Renderer flags (optional; unset = safe default) ---
# NEXT_PUBLIC_WEBGPU=true         # WebGPU backend; falls back to WebGL2 automatically
# NEXT_PUBLIC_IBL_SHADOWS=true    # soft contact shadows. WebGL2 ONLY — the pipeline
#                                 # renders the whole frame black on WebGPU, so the
#                                 # two flags are mutually exclusive in practice.
