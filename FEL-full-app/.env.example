# FEL — environment variables. Copy to .env and fill in real values.
# There was no .env / .env.example in this repo before this pass — Prisma,
# NextAuth, and Stripe all fail at startup without one.

# --- Database (required) ---
# A localhost value here is correct for local dev and CATASTROPHIC in a deploy:
# 127.0.0.1 is the container's own loopback, so Prisma reaches nothing, and the
# app still boots and serves pages while EVERY sign-in and signup fails. Verify
# after each deploy — the liveness probes cannot catch this:
#     curl https://<domain>/api/health/db     -> {"ok":true,...}
# The hosted database is Cloud SQL for PostgreSQL, reachable over TLS only.
#   DATABASE_URL = what the app connects with. Keep ?sslmode=require and a small connection_limit:
#                  every server instance opens its own Prisma client.
#   DIRECT_URL   = the same database without the pool cap. Used only by `prisma db push` / `migrate`
#                  (schema.prisma declares directUrl).
# Local dev can point both at the same local Postgres (scripts/dev-setup.sh writes that .env).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=3"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Cloud SQL Node.js Connector (production; lib/db/cloudSql.ts) ---
# Set CLOUD_SQL_INSTANCE (project:region:instance) and the app connects through the connector's local unix socket
# with DB_USER / DB_PASS / DB_NAME instead of DATABASE_URL. Empty = plain DATABASE_URL (local dev, tests).
# CLOUD_SQL_IP_TYPE: PUBLIC (default) | PRIVATE | PSC. DB_CONNECTION_LIMIT: Prisma pool per server instance (default 5).
CLOUD_SQL_INSTANCE=""
DB_USER=""
DB_PASS=""
DB_NAME=""
CLOUD_SQL_IP_TYPE=""
DB_CONNECTION_LIMIT=""

# --- Auth (required) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public origin of the running app, no trailing slash. NextAuth builds callback
# and redirect URLs from this: a localhost value in a deploy sends athletes to a
# dead page after an OTHERWISE SUCCESSFUL login.
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 renamed these; harmless to set both while on v4.
# AUTH_SECRET=
# AUTH_TRUST_HOST=

# --- Stripe (required for payments/checkout/webhook routes) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_COINS_SMALL=""
STRIPE_PRICE_COINS_LARGE=""
# Default: NO payment_method_types is sent, so Stripe's automatic payment methods show whatever the
# Dashboard has enabled (card, Link, Cash App, Afterpay/Clearpay, Klarna, Affirm, Apple/Google Pay,
# PayPal). "1" = opt back INTO the fixed pinned lists (lib/stripe-payment-methods.ts).
STRIPE_PM_PIN=""

# --- Object storage (asset uploads: closet items, creative cards, etc.) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""
# Creator card media uploads (app/api/v1/creative-card/upload-url): both buckets are required before music,
# voice, image, cover and private teen uploads can leave the device. They must be distinct GCS buckets.
# Pending/private bucket: private, lifecycle-cleans pending/; public bucket: public-read + CORS for the app origin.
CREATOR_MEDIA_BUCKET=""
CREATOR_MEDIA_PUBLIC_BUCKET=""

# --- OAuth providers (optional; only needed if these sign-in methods ship) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# --- Misc integrations ---
# AI/tooling calls stay off unless both ABACUS_ENABLED=true and the service key are present.
ABACUS_ENABLED=""
ABACUSAI_API_KEY=""
CHALLENGE_SIGN_SECRET="generate-a-random-secret"
NEXUS_GATEWAY_URL=""
NOTIF_ID_COME_BACK_PLAY=""
NOTIF_ID_NEW_LEAD_CAPTURED=""
NOTIF_ID_REFERRAL_REWARD=""
NOTIF_ID_WELCOME_EMAIL=""
# Abacus app id sent with the marketing-email notification calls (lib/marketing/email.ts).
WEB_APP_ID=""

# --- Server feature flags (lib/flags.ts; ON only for 1/true/on/yes, empty = OFF) ---
# NEXUS Studio creator monetization surface (subscriptions, metering, publishing).
STUDIO_CREATOR_ENABLED=""
# Nexus Studio, the editor at /studio (docs/NEXUS-STUDIO.md). Off: /studio is a 404. Does not open the paid surface above.
NEXUS_STUDIO_ENABLED=""
# Nexus Studio share links (lib/nexus-studio/share.ts): a creator's venue played by link, practice only. Off: every share route is a 404.
STUDIO_SHARE_ENABLED=""
# The feel panel (docs/FEEL-PANEL.md): hidden feel-knob sliders, overrides on that device in playtest runs only.
FEEL_PANEL_ENABLED=""
# Who may open it: a comma list of User ids (admins may too). Opens the feel panel and nothing else.
FEEL_PANEL_USERS=""
# Real-money competition (escrow, KYC, geo-gating).
REAL_MONEY_COMPETITION=""
# Season pass PRO-lane checkout; POST /api/season/checkout answers 403 while off.
SEASON_PASS_PURCHASE=""
# PRO-lane price in USD cents. Owner-set, no default: empty = the checkout answers 409 store_closed price_not_set.
SEASON_PASS_PRO_PRICE_USD_CENTS=""
# No real-money checkout outside the coach store opens while this is off.
VIRTUAL_PURCHASES_ENABLED=""

# --- Operational/scheduled routes (server-only; owner wires secrets + schedulers) ---
# Retention cron: unset = POST /api/cron/retention answers 503 and deletes nothing.
RETENTION_CRON_SECRET=""
# Arena reclaim sweep: unset = POST /api/arena/reclaim answers 404. Also needs a scheduler.
ARENA_RECLAIM_SECRET=""
# Coach-store reconcile sweep: unset = POST /api/coach-store/reconcile answers 404. Listed in firebase.json secrets.
COACH_STORE_RECONCILE_SECRET=""

# --- Selling (LAUNCH-SALES, 2026-10-20). Every switch below defaults OFF; turn them on in the order in
# docs/LAUNCH-SALES.md, test mode first. Never put a real key or secret in this file. ---
# STORE-READY B10 fence: every real-money checkout that is not the coach store (FEL Pro weekly/monthly, FEL Coach,
# FEL Facility, Studio Creator, cosmetics, coin/shard/studio-credit packs, the season pass PRO lane, books) answers
# 409 store_closed virtual_purchases_off while this is off. Each of them checks 18+ (403 adults_only) and has a refund
# path (charge.refunded on /api/stripe/webhook revokes it).
VIRTUAL_PURCHASES_ENABLED=""
# PAYMENTS-READY: per-product allow list under VIRTUAL_PURCHASES_ENABLED (lib/payments/allowlist.ts). Empty = exactly as
# before (the switch alone decides). Set = only these sell, e.g. "fel_pro,coins"; every other product answers 409
# store_closed virtual_purchases_off. Ids: fel_pro, fel_coach, fel_facility, studio_creator, cosmetic, coach_program,
# marketplace, studio_credits, coins, shards, season_pass, books. Check with: npx tsx scripts/payments-preflight.ts
PURCHASES_ALLOWLIST=""
# Coach store (docs/coach-store.md). Off = the store's pages and routes are a 404. Needs the coach-store SQL first.
COACH_STORE_ENABLED=""
# Coach-store checkout. Off = 409 store_closed payments_off. Test keys only unless COACH_STORE_LIVE is on.
COACH_STORE_PAYMENTS_ENABLED=""
# The coach store's live switch: a LIVE Stripe key (sk_live_/rk_live_) sells in the coach store only while this is on.
# Off = 409 store_closed live_mode_off. (Books refuse any key but sk_test_; the other products' live fence is
# VIRTUAL_PURCHASES_ENABLED, so a live STRIPE_SECRET_KEY must not be set before the owner's switch-on day.)
COACH_STORE_LIVE=""
# Comma-separated user ids allowed to sell in the coach store. Empty = nobody is a coach (every listing not_for_sale).
COACH_STORE_COACH_USER_IDS=""
# Shared secret for POST /api/coach-store/reconcile (header x-coach-store-reconcile-secret), the no-webhook catch-up
# for paid checkouts, Dashboard refunds and disputes. Empty = the route is a 404. 32+ random bytes.
COACH_STORE_RECONCILE_SECRET=""
# Selling async video review and its signed upload URLs. Off (or no bucket) = "Uploads coming soon".
COACH_REVIEW_UPLOADS_ENABLED=""
# Private GCS bucket for review clips (originals under coach-reviews/originals/, replies under coach-reviews/replies/).
COACH_REVIEWS_BUCKET=""

# --- Coach live sessions (docs/COACH-LIVE.md; default OFF) ---
# Peer-to-peer coach <-> client video + pose overlay. Read on the client, so NEXT_PUBLIC_. Leave off until the owner switches it on.
NEXT_PUBLIC_COACH_LIVE_ENABLED=""
# Share of FEL's 15% fee paid to a referrer. Empty = 0.20 (3% of the sale). Clamped 0-0.5.
COACH_STORE_REFERRAL_SHARE_OF_FEE=""
# Extra comma-separated substrings refused as a coach's business mailing address (a home address is never used).
COACH_STORE_BLOCKED_ADDRESS_TERMS=""
# Unused in v1 (live 1:1 calls are STUN-only, lib/coach-store/call/iceServers.ts). Leave empty.
COACH_CALL_TURN_URLS=""
COACH_CALL_TURN_SECRET=""
# Real Stripe transfers to creators (Connect, P5). Off = /api/stripe/payout answers 503 and writes nothing. Stays off.
PAYOUTS_ENABLED=""
# Alias of STRIPE_BOOKS_TAX (below): "1" turns on automatic_tax for book checkouts. Needs Stripe Tax activated first.
STRIPE_TAX_ENABLED=""

# --- Coach business (COACH-BUSINESS, 2026-10-25; docs/COACH-BUSINESS.md). Every switch defaults OFF. ---
# Coaches charging clients through Stripe Connect (Express): onboarding, package checkout (FEL's 5% + the buyer's
# processing fee, lib/coach-business/fees.ts), refunds, the payouts dashboard link. Off = every money route answers 409 store_closed payments_off ("Payments aren't live yet").
COACH_CONNECT_PAYMENTS_ENABLED=""
# A LIVE Stripe key opens the Connect routes and the Coach Pro upgrade only while this is on. Off = test mode only.
COACH_CONNECT_LIVE=""
# The Free/Pro gates (Free: COACH_FREE_CLIENT_LIMIT clients; Pro: unlimited clients, AI drafts, live sessions, payments)
# and the Coach Pro upgrade. Off = nothing is gated and Pro is not sold.
COACH_PRO_ENABLED=""
# Coach Pro (= FEL Coach) price per month, in USD cents. Empty = 3900 ($39, owner 2026-10-25). Drives the upgrade,
# /api/stripe/checkout FEL_COACH and the B2B paywall line alike.
COACH_PRO_PRICE_USD_CENTS=""
# Active clients a Free coach keeps while COACH_PRO_ENABLED is on. Empty = 3.
COACH_FREE_CLIENT_LIMIT=""
# /coaches (find a coach) and applying to a coach. Off = /coaches is a 404.
COACH_MARKETPLACE_ENABLED=""
# PAYMENTS-READY (owner calls, lib/coach-business/config.ts). MONEY settings; empty = today's behaviour.
# FEL's share of a coach's sale, in basis points, by the coach's plan. Empty = FREE 500 (5%), PRO 0 (0%) (owner, 2026-10-27).
PLATFORM_FEE_BPS_FREE=""
PLATFORM_FEE_BPS_PRO=""
# The most FEL takes from one coach per calendar month (UTC), in cents, read from the ledger. Empty = no cap.
PLATFORM_FEE_CAP_CENTS_MONTHLY=""
# A refund of a coach's sale also returns the buyer's share of the processing fee (FEL absorbs Stripe's fee; the coach's
# outcome is unchanged). Empty = on (owner, 2026-10-27: "refund in full"). "0" = the processing fee is not refunded.
REFUND_PROCESSING_FEE=""
# The signing secret of the Stripe "events on connected accounts" endpoint (same URL, /api/stripe/webhook, subscribed to
# account.updated). Empty = coaches' account status refreshes only when they come back from Stripe onboarding.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# --- Coach check-ins, habits and program import (COACH-PARITY, 2026-10-26; docs/COACH-PARITY.md). Both default OFF. ---
# Check-ins and habits themselves turn on when prisma/pending/2026-10-26-coach-parity.sql is applied (no switch).
# Health questions in a check-in and health habits (sleep, body weight, food). Their athlete-facing lines are DRAFTS for
# the owner (lib/coach/checkins/copy.ts, lib/coach/habits/copy.ts). "true" only after the owner approves that wording.
COACH_PARITY_HEALTH_ENABLED=""
# The importer's AI reader for a paste the rules could not read. Also needs ABACUS_ENABLED and ABACUSAI_API_KEY.
COACH_IMPORT_AI_ENABLED=""

# --- Coach delivery (COACH-DELIVERY, 2026-10-26; docs/COACH-DELIVERY.md). Features turn on when
# prisma/pending/2026-10-26-coach-delivery.sql is applied; these default OFF/unset. ---
# Shared secret for the hourly automation sweep (POST /api/coach/automations/sweep, header x-coach-automations-secret).
# Empty = the route answers 503 and nothing runs on a schedule (a coach's "Run now" still works). 16+ characters.
COACH_AUTOMATIONS_CRON_SECRET=""
# A coach's own demo video upload to CREATOR_MEDIA_PUBLIC_BUCKET (coach-videos/), COA-08. Off (or no bucket) = no Upload button.
COACH_VIDEO_UPLOADS_ENABLED=""

# --- Hero body ---
# Comma-separated sign-in emails that wear the owner's body scan (app/api/v1/hero-body); empty = everyone plays the kit body.
FEL_SCAN_OWNER_EMAILS=""
# Comma-separated ids or emails that earn no rewards in production/test probes.
FEL_TEST_ACCOUNTS=""

# --- Coach store (docs/coach-store.md; all flags default OFF) ---
COACH_STORE_ENABLED=""
COACH_STORE_PAYMENTS_ENABLED=""
# A live Stripe key is refused unless this is also on. Leave off until real money is intentionally live.
COACH_STORE_LIVE=""
COACH_REVIEW_UPLOADS_ENABLED=""
COACH_REVIEWS_BUCKET=""
COACH_STORE_COACH_USER_IDS=""
COACH_STORE_REFERRAL_SHARE_OF_FEE=""
COACH_STORE_BLOCKED_ADDRESS_TERMS=""
PAYOUTS_ENABLED=""

# --- Client-side feature flags (all optional; unset = feature default) ---
# NEXT_PUBLIC_DISABLE_3D=1              # kill-switch: force every mode back to Canvas 2D
# NEXT_PUBLIC_FEL_BODY_RIDE=all         # probe/dev only: force body bindings for ride modes already default-on in prod
# NEXT_PUBLIC_DUNK_FINISH_VARIETY=1
# NEXT_PUBLIC_MOCAP_DUNK=1
# NEXT_PUBLIC_NEXUS_ENABLED=1
# NEXT_PUBLIC_PLAYTEST_MODE=1
# NEXT_PUBLIC_PREMIUM_DRESSING=1
# NEXT_PUBLIC_PROCEDURAL_CHARACTERS=1
# NEXT_PUBLIC_PROCEDURAL_ENVIRONMENTS=1
# NEXT_PUBLIC_SKINNED_BODY=false        # procedural athletes fall back to the rigid-primitive body
# NEXT_PUBLIC_JOIN_LAB_ENABLED=true     # build-time: shows the signed-out Join the Lab email form.
# NEXT_PUBLIC_JUMP_PILOT_CAPTURE=1     # build-time, OFF: the force-plate pilot's capture mode on the adult jump result (per-trial timing CSV). The lab's build only; docs/JUMP-PILOT-PROTOCOL.md.

# --- Public route flags ---
# Off = /live/schedule 404s. This is a server-side flag, not NEXT_PUBLIC_.
LIVE_STREAM_SCHEDULE_ENABLED=""
# Off = the Closet face-scan entry stays hidden.
FACE_SCAN_ENABLED=""

# --- Controller Link (phone-as-controller, §6.5) ---
# REQUIRED IN PRODUCTION. Without these the signaling store falls back to an
# in-process Map, which is correct in dev and BROKEN on Vercel: each serverless
# invocation may land in a different isolate with its own empty Map, so a phone's
# answer is written to one instance and polled from another that never sees it.
# The join simply never completes. Any Upstash/Vercel-KV-compatible REST endpoint
# works — see lib/controller-link/kvSignalStore.ts.
CONTROLLER_LINK_KV_URL=""
CONTROLLER_LINK_KV_TOKEN=""

# --- Realtime netplay relay ---
# Optional locally; required for hosted multiplayer rooms. Run `server/netd`
# separately and expose its WebSocket endpoint, for example:
#   ws://localhost:8080
#   wss://fel-netd.example.com
NEXT_PUBLIC_NETD_URL=""
# netd listens on PORT when Cloud Run injects it; unset = 8080 locally.
PORT=""

# --- PSN-style party (PARTY-CHAT, 2026-10-13; server/netd/README.md "Parties") ---
# The SAME secret on the app and on netd (Cloud Run). The app signs who is a verified adult (User.dobYear, strict
# rule); netd believes only that signature. Unset (either side) = everyone gets teen rules in parties: quick chat and
# emotes only, no typed chat, no voice. Server-only: never NEXT_PUBLIC_. 32+ random bytes, e.g. `openssl rand -base64 48`.
PARTY_TICKET_SECRET=""
# Optional TURN relay for party voice on networks where peer-to-peer cannot connect. Both set = relay on. The secret
# is coturn's static-auth-secret: the browser only ever gets a short-lived HMAC credential, never this value.
PARTY_TURN_URLS=""
PARTY_TURN_SECRET=""

# --- Renderer flags (optional; unset = safe default) ---
# NEXT_PUBLIC_WEBGPU=true         # WebGPU backend; falls back to WebGL2 automatically
# NEXT_PUBLIC_IBL_SHADOWS=true    # soft contact shadows. WebGL2 ONLY — the pipeline
#                                 # renders the whole frame black on WebGPU, so the
#                                 # two flags are mutually exclusive in practice.
# NEXT_PUBLIC_QUALITY_TIER=mobile # force the render tier (mobile | desktop | high); unset = detected per device (then ?tier= and the in-game Graphics menu)

# --- Build (read by next.config.js; optional, unset = Next defaults) ---
# Left commented: an empty NEXT_OUTPUT_MODE would hand Next an invalid `output: ''`.
# NEXT_OUTPUT_MODE=standalone     # Next `output` mode
# NEXT_DIST_DIR=.next-verify      # build directory; a second concurrent Next server needs its own
# Host-supplied release labels surfaced by /api/health when present; do not set these by hand locally.
# K_REVISION=
# VERCEL_GIT_COMMIT_SHA=

# FEL Kitchens (docs/SPEC-FEL-KITCHENS.md) — fulfilment keys are env-only, server-only, never in git.
# Instacart Developer Platform: shopping-list link (v0.5, apply HOLD until pad-grade + AM paste + Elijah GO).
# Empty = the path renders locked and POST /api/kitchens/instacart-list answers 409. Tests use a fake in-process value only.
INSTACART_IDP_KEY=""
# Optional: the IDP host. Unset = the dev sandbox (https://connect.dev.instacart.tools); set the production host to go live.
# INSTACART_IDP_HOST=""
# DoorDash Drive: white-label delivery from a pickup / pack node (documented only until a partner kitchen exists).
DOORDASH_DRIVE_KEY=""

# --- Final Evolution Press (direct books). See docs/BOOK-SHOP.md. No real secrets here. ---
# Books are sold through the PLATFORM Stripe account (STRIPE_SECRET_KEY, the coach store's). There is no separate
# books key. Book checkout refuses any key that is not sk_test_, even if the platform key is live.
# BOOK_STORE_ENABLED is the books' own switch. Default OFF: unset or anything but 1/true/on/yes keeps checkout closed
# (409 store_closed / book_store_off). It also stays closed while VIRTUAL_PURCHASES_ENABLED (the B10 fence) is off and
# while NEXTAUTH_URL is unset (Stripe return URLs come from it, never the request's Origin header). Buyers must be
# signed in, a verified adult, and tick the store terms (STORE_TERMS_VERSION). No guest checkout.
# Go-live is blocked on LEGAL-COPY-2 for books; see docs/BOOK-SHOP.md.
# BOOK_STORE_ENABLED=""
# Optional: the signing secret of a separate /api/books/webhook endpoint. Falls back to STRIPE_WEBHOOK_SECRET. The
# shared /api/stripe/webhook already records book sales, so you can leave this unset.
# STRIPE_BOOKS_WEBHOOK_SECRET=""
# "1" turns automatic_tax on for book Checkout Sessions. Stripe Tax must be activated in the Dashboard or session creation fails.
# STRIPE_BOOKS_TAX=""
# Private Firebase Storage bucket. Objects are not public; the server signs short-lived V4 URLs.
# FIREBASE_STORAGE_BUCKET="final-evolution-lab.firebasestorage.app"
# Service account that can sign reads. Paste the JSON as one line, or set the email + key. Never commit either.
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
# Signed URL lifetime in seconds. Capped at 3600. Default 600.
# BOOK_SIGNED_URL_TTL_SECONDS="600"

# --- FEL Creator Platform (team profiles, media kit, work-with-us inquiries). See docs/CREATOR-PLATFORM.md. ---
# No environment variables. Inquiries are stored in Postgres (DATABASE_URL) in the CreatorInquiry table, which is
# pending SQL (prisma/pending/2026-10-13-creator-inquiry.sql); until the owner applies it the form says
# "Inquiries are unavailable right now". The booking engine, Firestore, Printful, Stripe Connect and the inquiry IP
# salt (CREATOR_IP_SALT) are gone. The Book buttons go to the coach store.

# --- Email (lib/mail; coach-loop P1). Sent from the owner's Google Workspace mailbox through the Gmail API. ---
# OFF unless exactly "true". Off, nothing is sent: invites keep their link and code, alerts stay on the coach's board.
EMAIL_ENABLED=""
# gmail_api (default) sends for real; log only writes "one message accepted" to the server log (no address, no body).
MAIL_TRANSPORT="gmail_api"
# The Workspace mailbox that sends. The service account below acts as this user (domain-wide delegation).
MAIL_FROM=""
# Display name on the From line. Default "Final Evolution Lab".
MAIL_FROM_NAME=""
# Service account with domain-wide delegation for https://www.googleapis.com/auth/gmail.send ONLY. Set in the owner's
# ops session, never committed. The key is the PEM from the JSON key file, on one line with \n escapes.
GOOGLE_MAIL_SA_EMAIL=""
GOOGLE_MAIL_SA_PRIVATE_KEY=""
# Email links (invites, guardian reports) point at NEXTAUTH_URL above, never at a request's Host header.

# --- Installable app: service worker (app-feel, round 7). public/sw.js, registered by components/pwa/sw-register.tsx. ---
# OFF unless "1" or "true", and only in a production build. Ships OFF: the owner turns it on after a device check.
# Build-time (NEXT_PUBLIC_): flipping it is a rebuild + deploy. It is also the KILL SWITCH: set back to off, every page
# load unregisters the worker and deletes its fel-* caches. The worker never caches pages or /api (docs/PERF-CACHE-PROPOSAL.md).
NEXT_PUBLIC_SW_ENABLED=""

# --- Combine day (lib/combine; lane/combine-day 2026-10-25). Saving needs prisma/pending/2026-10-25-combine-day.sql. ---
# Build-time. OFF unless exactly "true". The combine's DRAFT privacy and consent lines (who is held and why, what stays
# on the coach's phone, who sees results: lib/combine/copy.ts) await the owner's approval; off, short placeholders show.
NEXT_PUBLIC_COMBINE_DRAFT_COPY=""
