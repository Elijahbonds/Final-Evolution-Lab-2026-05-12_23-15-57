# FEL — environment variables. Copy to .env and fill in real values.
# There was no .env / .env.example in this repo before this pass — Prisma,
# NextAuth, and Stripe all fail at startup without one.

# --- Database (required) ---
# A localhost value here is correct for local dev and CATASTROPHIC in a deploy:
# 127.0.0.1 is the container's own loopback, so Prisma reaches nothing, and the
# app still boots and serves pages while EVERY sign-in and signup fails. Verify
# after each deploy — the liveness probes cannot catch this:
#     curl https://<domain>/api/health/db     -> {"ok":true,...}
# The hosted database is Cloud SQL for PostgreSQL, reachable over TLS only.
#   DATABASE_URL = what the app connects with. Keep ?sslmode=require and a small connection_limit:
#                  every server instance opens its own Prisma client.
#   DIRECT_URL   = the same database without the pool cap. Used only by `prisma db push` / `migrate`
#                  (schema.prisma declares directUrl).
# Local dev can point both at the same local Postgres (scripts/dev-setup.sh writes that .env).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=3"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Auth (required) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public origin of the running app, no trailing slash. NextAuth builds callback
# and redirect URLs from this: a localhost value in a deploy sends athletes to a
# dead page after an OTHERWISE SUCCESSFUL login.
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 renamed these; harmless to set both while on v4.
# AUTH_SECRET=
# AUTH_TRUST_HOST=

# --- Stripe (required for payments/checkout/webhook routes) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_COINS_SMALL=""
STRIPE_PRICE_COINS_LARGE=""
# "1" = send no payment_method_types and let the Stripe Dashboard decide (lib/stripe-payment-methods.ts).
STRIPE_PM_AUTO=""

# --- Object storage (asset uploads: closet items, creative cards, etc.) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# --- OAuth providers (optional; only needed if these sign-in methods ship) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# --- Misc integrations ---
ABACUSAI_API_KEY=""
CHALLENGE_SIGN_SECRET="generate-a-random-secret"
NEXUS_GATEWAY_URL=""
NOTIF_ID_COME_BACK_PLAY=""
NOTIF_ID_NEW_LEAD_CAPTURED=""
NOTIF_ID_REFERRAL_REWARD=""
NOTIF_ID_WELCOME_EMAIL=""
# Abacus app id sent with the marketing-email notification calls (lib/marketing/email.ts).
WEB_APP_ID=""

# --- Server feature flags (lib/flags.ts; ON only for 1/true/on/yes, empty = OFF) ---
# NEXUS Studio creator monetization surface (subscriptions, metering, publishing).
STUDIO_CREATOR_ENABLED=""
# Real-money competition (escrow, KYC, geo-gating).
REAL_MONEY_COMPETITION=""
# Season pass PRO-lane checkout; POST /api/season/checkout answers 403 while off.
SEASON_PASS_PURCHASE=""
# PRO-lane price in USD cents. Owner-set, no default: empty = the checkout answers 503 not_configured.
SEASON_PASS_PRO_PRICE_USD_CENTS=""

# --- Hero body ---
# Comma-separated sign-in emails that wear the owner's body scan (app/api/v1/hero-body); empty = everyone plays the kit body.
FEL_SCAN_OWNER_EMAILS=""

# --- Client-side feature flags (all optional; unset = feature default) ---
# NEXT_PUBLIC_DISABLE_3D=1              # kill-switch: force every mode back to Canvas 2D
# NEXT_PUBLIC_DUNK_FINISH_VARIETY=1
# NEXT_PUBLIC_MOCAP_DUNK=1
# NEXT_PUBLIC_NEXUS_ENABLED=1
# NEXT_PUBLIC_PLAYTEST_MODE=1
# NEXT_PUBLIC_PREMIUM_DRESSING=1
# NEXT_PUBLIC_PROCEDURAL_CHARACTERS=1
# NEXT_PUBLIC_PROCEDURAL_ENVIRONMENTS=1
# NEXT_PUBLIC_SKINNED_BODY=false        # procedural athletes fall back to the rigid-primitive body

# --- Controller Link (phone-as-controller, §6.5) ---
# REQUIRED IN PRODUCTION. Without these the signaling store falls back to an
# in-process Map, which is correct in dev and BROKEN on Vercel: each serverless
# invocation may land in a different isolate with its own empty Map, so a phone's
# answer is written to one instance and polled from another that never sees it.
# The join simply never completes. Any Upstash/Vercel-KV-compatible REST endpoint
# works — see lib/controller-link/kvSignalStore.ts.
CONTROLLER_LINK_KV_URL=""
CONTROLLER_LINK_KV_TOKEN=""

# --- Realtime netplay relay ---
# Optional locally; required for hosted multiplayer rooms. Run `server/netd`
# separately and expose its WebSocket endpoint, for example:
#   ws://localhost:8080
#   wss://fel-netd.example.com
NEXT_PUBLIC_NETD_URL=""

# --- Renderer flags (optional; unset = safe default) ---
# NEXT_PUBLIC_WEBGPU=true         # WebGPU backend; falls back to WebGL2 automatically
# NEXT_PUBLIC_IBL_SHADOWS=true    # soft contact shadows. WebGL2 ONLY — the pipeline
#                                 # renders the whole frame black on WebGPU, so the
#                                 # two flags are mutually exclusive in practice.
# NEXT_PUBLIC_QUALITY_TIER=mobile # force the render tier (mobile | desktop); unset = detected per device

# --- Build (read by next.config.js; optional, unset = Next defaults) ---
# Left commented: an empty NEXT_OUTPUT_MODE would hand Next an invalid `output: ''`.
# NEXT_OUTPUT_MODE=standalone     # Next `output` mode
# NEXT_DIST_DIR=.next-verify      # build directory; a second concurrent Next server needs its own

# FEL Kitchens (docs/SPEC-FEL-KITCHENS.md) — fulfilment keys are env-only, server-only, never in git.
# Instacart Developer Platform: shopping-list link (v0.5, apply HOLD until pad-grade + AM paste + Elijah GO).
# Empty = the path renders locked and POST /api/kitchens/instacart-list answers 409. Tests use a fake in-process value only.
INSTACART_IDP_KEY=""
# Optional: the IDP host. Unset = the dev sandbox (https://connect.dev.instacart.tools); set the production host to go live.
# INSTACART_IDP_HOST=""
# DoorDash Drive: white-label delivery from a pickup / pack node (documented only until a partner kitchen exists).
DOORDASH_DRIVE_KEY=""
