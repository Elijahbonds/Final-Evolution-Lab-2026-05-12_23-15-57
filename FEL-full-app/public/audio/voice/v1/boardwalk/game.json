sed for business!","off":538940,"len":10823,"sec":1.47},{"id":"game.block.05","moment":"game.block","text":"Pier security, denied!","off":549763,"len":10155,"sec":1.302},{"id":"game.block.06","moment":"game.block","text":"Shut the gate!","off":559918,"len":7886,"sec":0.772},{"id":"game.blocked.01","moment":"game.blocked","text":"Ooh, stuffed at the rim!","off":567804,"len":9219,"sec":1.098},{"id":"game.blocked.02","moment":"game.blocked","text":"Denied at the door!","off":577023,"len":8809,"sec":0.995},{"id":"game.blocked.03","moment":"game.blocked","text":"They saw that coming!","off":585832,"len":9253,"sec":1.13},{"id":"game.blocked.04","moment":"game.blocked","text":"Wall went up! Regroup, kid!","off":595085,"len":10511,"sec":1.339},{"id":"game.steal.01","moment":"game.steal","text":"Snatched it! Gone!","off":605596,"len":8861,"sec":1.022},{"id":"game.steal.02","moment":"game.steal","text":"Picked clean!","off":614457,"len":7864,"sec":0.796},{"id":"game.steal.03","moment":"game.steal","text":"Swiped! Off to the races!","off":622321,"len":11316,"sec":1.462},{"id":"game.steal.04","moment":"game.steal","text":"Takeaway! Let's go!","off":633637,"len":9784,"sec":1.155},{"id":"game.steal.05","moment":"game.steal","text":"Too quick, tide's turning!","off":643421,"len":10546,"sec":1.315},{"id":"game.stolen.01","moment":"game.stolen","text":"Picked off! Get back!","off":653967,"len":9008,"sec":1.041},{"id":"game.stolen.02","moment":"game.stolen","text":"Ooh, lost it!","off":662975,"len":7577,"sec":0.76},{"id":"game.stolen.03","moment":"game.stolen","text":"Seagull got your fries!","off":670552,"len":10138,"sec":1.257},{"id":"game.stolen.04","moment":"game.stolen","text":"Turnover! Shake it off!","off":680690,"len":9461,"sec":1.153},{"id":"game.ankles.01","moment":"game.ankles","text":"Sneakers with the handle!","off":690151,"len":10251,"sec":1.259},{"id":"game.ankles.02","moment":"game.ankles","text":"Ankle check on the boardwalk!","off":700402,"len":11154,"sec":1.455},{"