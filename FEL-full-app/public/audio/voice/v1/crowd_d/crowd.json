{"cast":"crowd_d","group":"crowd","bank":"crowd.2b63db738b.bin","lines":[{"id":"crowd.hype.01","moment":"crowd.hype","text":"Show us something, kid!","off":0,"len":9285,"sec":1.506},{"id":"crowd.hype.02","moment":"crowd.hype","text":"Wake me up, champ!","off":9285,"len":8892,"sec":1.296},{"id":"crowd.hype.03","moment":"crowd.hype","text":"Eyes up, folks!","off":18177,"len":8797,"sec":1.344},{"id":"crowd.hype.04","moment":"crowd.hype","text":"Don't let me down!","off":26974,"len":8603,"sec":1.26},{"id":"crowd.ooh.01","moment":"crowd.ooh","text":"Ha! Fancy!","off":35577,"len":8267,"sec":1.178},{"id":"crowd.ooh.02","moment":"crowd.ooh","text":"Would you look!","off":43844,"len":7760,"sec":0.967},{"id":"crowd.ooh.03","moment":"crowd.ooh","text":"Ooh, showboat!","off":51604,"len":8449,"sec":1.175},{"id":"crowd.cheer.01","moment":"crowd.cheer","text":"Ha! There it is!","off":60053,"len":8547,"sec":1.219},{"id":"crowd.cheer.02","moment":"crowd.cheer","text":"About time!","off":68600,"len":7965,"sec":1.04},{"id":"crowd.cheer.03","moment":"crowd.cheer","text":"Knew you had it!","off":76565,"len":8131,"sec":1.088},{"id":"crowd.cheer.04","moment":"crowd.cheer","text":"Now we're talking!","off":84696,"len":8831,"sec":1.3},{"id":"crowd.erupt.01","moment":"crowd.erupt","text":"Oh, stop it! Stop it!","off":93527,"len":9861,"sec":1.604},{"id":"crowd.erupt.02","moment":"crowd.erupt","text":"There goes my hot dog!","off":103388,"len":9988,"sec":1.701},{"id":"crowd.erupt.03","moment":"crowd.erupt","text":"Somebody hold me up!","off":113376,"len":8377,"sec":1.204},{"id":"crowd.erupt.04","moment":"crowd.erupt","text":"Unbelievable! Just unbelievable!","off":121753,"len":12260,"sec":2.424},{"id":"crowd.groan.01","moment":"crowd.groan","text":"Next one, kid!","off":134013,"len":8452,"sec":1.186},{"id":"crowd.groan.02","moment":"crowd.groan","text":"Aw, shake it off!","off":142465,"len":9064,"sec":1.367},{"id":"crowd.groan.03","moment":"crowd.groan","text":"Whoops!","off":151529,"len":6674,"sec":0.66},{"id":"crowd.heckle.01","moment":"crowd.heckle","text":"The bench could do better!","off":158203,"len":9416,"sec":1.502},{"id":"crowd.heckle.02","moment":"crowd.heckle","text":"Swing and a miss!","off":167619,"len":8680,"sec":1.278},{"id":"crowd.heckle.03","moment":"crowd.heckle","text":"I'd have missed that too!","off":176299,"len":9217,"sec":1.474},{"id":"crowd.idle.01","moment":"crowd.idle","text":"I played here once. Badly, but I played!","off":185516,"len":13428,"sec":2.705},{"id":"crowd.idle.02","moment":"crowd.idle","text":"Kid, I'll lend you my lucky sneakers.","off":198944,"len":12196,"sec":2.323},{"id":"crowd.idle.03","moment":"crowd.idle","text":"I'm not heckling, I'm coaching!","off":211140,"len":10747,"sec":1.91},{"id":"crowd.idle.04","moment":"crowd.idle","text":"Don't tell my doctor I'm yelling.","off":221887,"len":11546,"sec":2.099},{"id":"crowd.idle.05","moment":"crowd.idle","text":"Easy on the rim, it's older than me!","off":233433,"len":12071,"sec":2.3},{"id":"crowd.defense.01","moment":"crowd.defense","text":"Hold the line!","off":245504,"len":7735,"sec":1.033}]}