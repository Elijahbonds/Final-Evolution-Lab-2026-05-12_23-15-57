{"cast":"nova","group":"three","bank":"three.601de753ef.bin","lines":[{"id":"three.intro.01","moment":"three.intro","text":"Orbit, this is Downtown! Six shooters, five racks, sixty seconds on the clock, and only the top three advance.","off":0,"len":30363,"sec":6.191},{"id":"three.intro.02","moment":"three.intro","text":"Downtown is open for launch! Five racks, sixty seconds, money balls worth double. Six shooters, three seats in the final.","off":30363,"len":34115,"sec":7.073},{"id":"three.intro.03","moment":"three.intro","text":"Long-range mission tonight, Orbit! Sixty seconds, five racks, watch those money balls. Top three of six move on.","off":64478,"len":31217,"sec":6.562},{"id":"three.go.01","moment":"three.go","text":"Clock is live!","off":95695,"len":9177,"sec":1.099},{"id":"three.go.02","moment":"three.go","text":"Launch sequence started!","off":104872,"len":10628,"sec":1.355},{"id":"three.go.03","moment":"three.go","text":"Ignition! Go!","off":115500,"len":9202,"sec":1.086},{"id":"three.rack.01","moment":"three.rack","text":"Coordinates set, next rack!","off":124702,"len":11760,"sec":1.621},{"id":"three.rack.02","moment":"three.rack","text":"Fresh rack, fresh fuel!","off":136462,"len":10908,"sec":1.476},{"id":"three.rack.03","moment":"three.rack","text":"Keep the rhythm, next rack!","off":147370,"len":11639,"sec":1.563},{"id":"three.rack.04","moment":"three.rack","text":"On to the next station!","off":159009,"len":10645,"sec":1.364},{"id":"three.lastrack.01","moment":"three.lastrack","text":"Last rack! Final approach!","off":169654,"len":12054,"sec":1.721},{"id":"three.lastrack.02","moment":"three.lastrack","text":"Final rack. Bring it home!","off":181708,"len":11327,"sec":1.571},{"id":"three.lastrack.03","moment":"three.lastrack","text":"One rack left. Full burn!","off":193035,"len":11948,"sec":1.708},{"id":"three.money.01","moment":"three.money","text":"Money ball! Worth two!","off":204983,"len":10764,"sec":1.346},{"id":"three.money.02","moment":"three.money","text":"Here comes the money ball!","off":215747,"len":10942,"sec":1.448},{"id":"three.money.03","moment":"three.money","text":"Priority payload!","off":226689,"len":9684,"sec":1.215},{"id":"three.money.04","moment":"three.money","text":"Precious cargo! Worth double!","off":236373,"len":12333,"sec":1.724},{"id":"three.make.01","moment":"three.make","text":"Touchdown!","off":248706,"len":7848,"sec":0.837},{"id":"three.make.02","moment":"three.make","text":"Nothing but stars!","off":256554,"len":10182,"sec":1.251},{"id":"three.make.03","moment":"three.make","text":"Docked!","off":266736,"len":7846,"sec":0.703},{"id":"three.make.04","moment":"three.make","text":"Right on target!","off":274582,"len":9901,"sec":1.195},{"id":"three.make.05","moment":"three.make","text":"Splashdown!","off":284483,"len":8429,"sec":0.941},{"id":"three.make.06","moment":"three.make","text":"Clean landing!","off":292912,"len":8553,"sec":0.957},{"id":"three.make.money.01","moment":"three.make.money","text":"Money ball, touchdown! Double!","off":301465,"len":11920,"sec":1.696},{"id":"three.make.money.02","moment":"three.make.money","text":"Precious cargo delivered!","off":313385,"len":11552,"sec":1.549},{"id":"three.make.money.03","moment":"three.make.money","text":"Payload secured!","off":324937,"len":9398,"sec":1.158},{"id":"three.make.money.04","moment":"three.make.money","text":"Cash in the cosmos!","off":334335,"len":10762,"sec":1.395},{"id":"three.miss.01","moment":"three.miss","text":"Off target.","off":345097,"len":8299,"sec":0.902},{"id":"three.miss.02","moment":"three.miss","text":"No landing.","off":353396,"len":8808,"sec":0.941},{"id":"three.miss.03","moment":"three.miss","text":"Rim says negative.","off":362204,"len":10846,"sec":1.452},{"id":"three.miss.04","moment":"three.miss","text":"Just missed.","off":373050,"len":8450,"sec":0.882},{"id":"three.miss.05","moment":"three.miss","text":"Short of orbit.","off":381500,"len":8871,"sec":0.994},{"id":"three.streak.01","moment":"three.streak","text":"Locked on target now!","off":390371,"len":11120,"sec":1.41},{"id":"three.streak.02","moment":"three.streak","text":"String of landings!","off":401491,"len":9848,"sec":1.212},{"id":"three.streak.03","moment":"three.streak","text":"Rhythm is locked in!","off":411339,"len":10511,"sec":1.338},{"id":"three.streak.04","moment":"three.streak","text":"All systems green!","off":421850,"len":10394,"sec":1.359},{"id":"three.fire.01","moment":"three.fire","text":"Supernova! Every single one!","off":432244,"len":12380,"sec":1.794},{"id":"three.fire.02","moment":"three.fire","text":"Clean rack! A perfect orbit!","tags":["rack:clean"],"off":444624,"len":12110,"sec":1.713},{"id":"three.fire.03","moment":"three.fire","text":"Light speed, Downtown! Unstoppable!","off":456734,"len":13659,"sec":2.14},{"id":"three.fire.04","moment":"three.fire","text":"The basket is a black hole!","off":470393,"len":11477,"sec":1.552},{"id":"three.cold.01","moment":"three.cold","text":"Three straight misses. Time to recalibrate.","off":481870,"len":15382,"sec":2.599},{"id":"three.cold.02","moment":"three.cold","text":"Lost the signal. Find it again!","off":497252,"len":12356,"sec":1.874},{"id":"three.cold.03","moment":"three.cold","text":"Engines sputtering. Deep breath, reset.","off":509608,"len":15000,"sec":2.408},{"id":"three.clock.01","moment":"three.clock","text":"Ten seconds! Countdown is on!","off":524608,"len":12527,"sec":1.833},{"id":"three.clock.02","moment":"three.clock","text":"Hurry! Ten seconds left!","off":537135,"len":11313,"sec":1.565},{"id":"three.clock.03","moment":"three.clock","text":"Launch window closing! Ten seconds!","off":548448,"len":13622,"sec":2.083},{"id":"three.buzzer.01","moment":"three.buzzer","text":"After the horn, and it counts!","off":562070,"len":11451,"sec":1.611},{"id":"three.buzzer.02","moment":"three.buzzer","text":"Released in time! That one counts!","off":573521,"len":12468,"sec":1.894},{"id":"three.buzzer.03","moment":"three.buzzer","text":"Beat the clock! Points secured!","off":585989,"len":11754,"sec":1.587},{"id":"three.results.01","moment":"three.results","text":"Results are coming in from mission control. Shooter by shooter.","off":597743,"len":17994,"sec":3.298},{"id":"three.results.02","moment":"three.results","text":"Transmitting the qualifying numbers now. Six shooters, three seats.","off":615737,"len":19943,"sec":3.758},{"id":"three.advance.01","moment":"three.advance","text":"Next stage ignites soon, and you are on board!","off":635680,"len":15092,"sec":2.56},{"id":"three.advance.02","moment":"three.advance","text":"Stage one complete! Our cadet advances to the Downtown final!","off":650772,"len":20076,"sec":3.701},{"id":"three.advance.03","moment":"three.advance","text":"Qualified! You are cleared for the final round.","off":670848,"len":15375,"sec":2.454},{"id":"three.out.01","moment":"three.out","text":"Not this orbit. Qualifying ends here, but the range is always open.","off":686223,"len":21185,"sec":4.013},{"id":"three.out.02","moment":"three.out","text":"Just short of the final. Recalibrate the jumper and come back.","off":707408,"len":18538,"sec":3.28},{"id":"three.out.03","moment":"three.out","text":"Mission scrubbed in qualifying. Downtown will be here next launch.","off":725946,"len":18745,"sec":3.59},{"id":"three.final.01","moment":"three.final","text":"Countdown to the final! You go last, and you know the number. Launch it!","off":744691,"len":20559,"sec":3.761},{"id":"three.final.02","moment":"three.final","text":"Last launch of Downtown. The target is on the board. Hit it.","off":765250,"len":17981,"sec":3.281},{"id":"three.final.03","moment":"three.final","text":"Final round, final shooter. The mark is set. Now top it.","off":783231,"len":17811,"sec":3.293},{"id":"three.clinch.01","moment":"three.clinch","text":"Past the mark! It is won!","off":801042,"len":11219,"sec":1.504},{"id":"three.clinch.02","moment":"three.clinch","text":"That clinches it! Mission complete!","off":812261,"len":13008,"sec":1.909},{"id":"three.clinch.03","moment":"three.clinch","text":"Orbit achieved! Nobody catches you now!","off":825269,"len":14643,"sec":2.274},{"id":"three.champion.01","moment":"three.champion","text":"Downtown champion! Sharpest shooter in the solar system, and it is official!","off":839912,"len":22257,"sec":4.111},{"id":"three.champion.02","moment":"three.champion","text":"Mission control, record it! Three-point champion of the Zero-G Classic!","off":862169,"len":22475,"sec":4.23},{"id":"three.champion.03","moment":"three.champion","text":"Crown them, Orbit! Longest range in the galaxy, and a trophy to match!","off":884644,"len":21768,"sec":4.047}]}