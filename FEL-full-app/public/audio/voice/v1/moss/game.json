game.block","text":"Ooh, stuffed it!","off":537056,"len":8315,"sec":0.861},{"id":"game.block.05","moment":"game.block","text":"Sent back to the trees!","off":545371,"len":9988,"sec":1.209},{"id":"game.block.06","moment":"game.block","text":"Rooted like an oak! Blocked!","off":555359,"len":11043,"sec":1.447},{"id":"game.blocked.01","moment":"game.blocked","text":"Ooh, oak in the way!","off":566402,"len":9074,"sec":1.009},{"id":"game.blocked.02","moment":"game.blocked","text":"Ha, the defender said nope.","off":575476,"len":10297,"sec":1.325},{"id":"game.blocked.03","moment":"game.blocked","text":"Blocked! Shake it off.","off":585773,"len":9105,"sec":1.046},{"id":"game.blocked.04","moment":"game.blocked","text":"Right into the brambles!","off":594878,"len":9994,"sec":1.212},{"id":"game.steal.01","moment":"game.steal","text":"Picked like a berry!","off":604872,"len":8646,"sec":1.014},{"id":"game.steal.02","moment":"game.steal","text":"Sneaky as a squirrel!","off":613518,"len":9772,"sec":1.137},{"id":"game.steal.03","moment":"game.steal","text":"Ooh, took it clean!","off":623290,"len":8891,"sec":0.984},{"id":"game.steal.04","moment":"game.steal","text":"That's yours now!","off":632181,"len":8884,"sec":0.994},{"id":"game.steal.05","moment":"game.steal","text":"Quick as a fox!","off":641065,"len":8739,"sec":0.979},{"id":"game.stolen.01","moment":"game.stolen","text":"Ooh, lost in the leaves.","off":649804,"len":9605,"sec":1.167},{"id":"game.stolen.02","moment":"game.stolen","text":"Ha, squirrel took your acorn!","off":659409,"len":10746,"sec":1.388},{"id":"game.stolen.03","moment":"game.stolen","text":"Blew away. Chase it down!","off":670155,"len":10573,"sec":1.38},{"id":"game.stolen.04","moment":"game.stolen","text":"Stripped! Next one, hang on.","off":680728,"len":9953,"sec":1.285},{"id":"game.ankles.01","moment":"game.ankles","text":"Defender hit the moss!","off":690681,"len":9558,"sec":1.183},{"id":"game.ankles.02","moment":"game.ankles","text":"Ooh, planted in the ferns!","off":700239,"len":10226,"sec":1.272},{"id":"game.ankles.03","moment":"game.ankles","text":"Roots got tangled up!","off":710465,"len":10074,"sec":1.202},{"id":"game.ankles.04","moment":"game.ankles","text":"Twisted like a vine!","off":720539,"len":9453,"sec":1.08},{"id":"game.ankles.05","moment":"game.ankles","text":"Whoa, fell like a leaf!","off":729992,"len":9510,"sec":1.117},{"id":"game.ankles.06","moment":"game.ankles","text":"Which way's the trail?!","off":739502,"len":9504,"sec":1.085},{"id":"game.bite.01","moment":"game.bite","text":"Hopped like a frog!","off":749006,"len":9300,"sec":1.053},{"id":"game.bite.02","moment":"game.bite","text":"Up with the sparrows!","off":758306,"len":8779,"sec":1.009},{"id":"game.bite.03","moment":"game.bite","text":"Easy fake, easy bite!","off":767085,"len":10451,"sec":1.295},{"id":"game.bite.04","moment":"game.bite","text":"Chasing butterflies!","off":777536,"len":9809,"sec":1.226},{"id":"game.foul.01","moment":"game.foul","text":"Whistle in the woods.","off":787345,"len":9015,"sec":0.984},{"id":"game.foul.02","moment":"game.foul","text":"Easy, easy, there's a call.","off":796360,"len":10191,"sec":1.262},{"id":"game.foul.03","moment":"game.foul","text":"Birds heard that whistle!","off":806551,"len":9612,"sec":1.162},{"id":"game.foul.04","moment":"game.foul","text":"Pause the forest a second.","off":816163,"len":10893,"sec":1.347},{"id":"game.rival.make.01","moment":"game.rival.make","text":"Other side answers.","off":827056,"len":9630,"sec":1.125},{"id":"game.rival.make.02","moment":"game.rival.make","text":"A little breeze their way.","off":836686,"len":9714,"sec":1.192},{"id":"game.rival.make.03","moment":"game.rival.make","text":"Fair enough, that one's theirs.","off":846400,"len":10428,"sec":1.334},{"id":"game.rival.make.04","moment":"game.rival.make","text":"They're growing too.","off":856828,"len":8845,"sec":1.002},{"id":"game.rival.make.05","moment":"game.rival.make","text":"Answer back, friend. Plenty of trail.",