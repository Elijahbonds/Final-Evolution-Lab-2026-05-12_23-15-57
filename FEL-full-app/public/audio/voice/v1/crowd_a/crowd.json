{"cast":"crowd_a","group":"crowd","bank":"crowd.aa0d34b48b.bin","lines":[{"id":"crowd.hype.01","moment":"crowd.hype","text":"Here we go now!","off":0,"len":7496,"sec":0.951},{"id":"crowd.hype.02","moment":"crowd.hype","text":"Been waiting for this!","off":7496,"len":8095,"sec":1.08},{"id":"crowd.hype.03","moment":"crowd.hype","text":"This is the one!","off":15591,"len":7644,"sec":0.921},{"id":"crowd.hype.04","moment":"crowd.hype","text":"Nobody blink!","off":23235,"len":7650,"sec":0.886},{"id":"crowd.ooh.01","moment":"crowd.ooh","text":"Ooh, slick!","off":30885,"len":6983,"sec":0.699},{"id":"crowd.ooh.02","moment":"crowd.ooh","text":"Oh, that's nasty!","off":37868,"len":7944,"sec":1.022},{"id":"crowd.ooh.03","moment":"crowd.ooh","text":"Clean, clean, clean!","off":45812,"len":8336,"sec":1.173},{"id":"crowd.cheer.01","moment":"crowd.cheer","text":"Money, every time!","off":54148,"len":8647,"sec":1.171},{"id":"crowd.cheer.02","moment":"crowd.cheer","text":"Textbook! Just textbook!","off":62795,"len":9514,"sec":1.42},{"id":"crowd.cheer.03","moment":"crowd.cheer","text":"There you go!","off":72309,"len":6780,"sec":0.734},{"id":"crowd.cheer.04","moment":"crowd.cheer","text":"Pretty! So pretty!","off":79089,"len":8014,"sec":1.042},{"id":"crowd.erupt.01","moment":"crowd.erupt","text":"I'm out of my seat!","off":87103,"len":7992,"sec":1.016},{"id":"crowd.erupt.02","moment":"crowd.erupt","text":"Twenty years, never that!","off":95095,"len":9475,"sec":1.367},{"id":"crowd.erupt.03","moment":"crowd.erupt","text":"That's why I come here!","off":104570,"len":8471,"sec":1.16},{"id":"crowd.erupt.04","moment":"crowd.erupt","text":"Tell me that was real!","off":113041,"len":8367,"sec":1.079},{"id":"crowd.groan.01","moment":"crowd.groan","text":"That one hurts!","off":121408,"len":7388,"sec":0.888},{"id":"crowd.groan.02","moment":"crowd.groan","text":"No, no, no!","off":128796,"len":7303,"sec":0.838},{"id":"crowd.groan.03","moment":"crowd.groan","text":"It was right there!","off":136099,"len":7697,"sec":0.962},{"id":"crowd.heckle.01","moment":"crowd.heckle","text":"Brick! Brick! Brick!","off":143796,"len":8143,"sec":1.023},{"id":"crowd.heckle.02","moment":"crowd.heckle","text":"Practice, my friend. Practice!","off":151939,"len":10861,"sec":1.869},{"id":"crowd.heckle.03","moment":"crowd.heckle","text":"Seen better at warm-ups!","off":162800,"len":8674,"sec":1.256},{"id":"crowd.idle.01","moment":"crowd.idle","text":"I've had this seat since it opened.","off":171474,"len":10058,"sec":1.609},{"id":"crowd.idle.02","moment":"crowd.idle","text":"Somebody pass the popcorn down here!","off":181532,"len":10379,"sec":1.754},{"id":"crowd.idle.03","moment":"crowd.idle","text":"Watch this one.","off":191911,"len":7763,"sec":0.892},{"id":"crowd.idle.04","moment":"crowd.idle","text":"I know every crack in this court.","off":199674,"len":10071,"sec":1.596},{"id":"crowd.idle.05","moment":"crowd.idle","text":"Every night, same spot, same shout.","off":209745,"len":11101,"sec":1.941},{"id":"crowd.defense.01","moment":"crowd.defense","text":"Defense! Defense!","off":220846,"len":8296,"sec":1.124}]}