{"cast":"crowd_e","group":"crowd","bank":"crowd.b14612576d.bin","lines":[{"id":"crowd.hype.01","moment":"crowd.hype","text":"Alright, impress me.","off":0,"len":8714,"sec":1.24},{"id":"crowd.hype.02","moment":"crowd.hype","text":"Prove it!","off":8714,"len":6769,"sec":0.75},{"id":"crowd.hype.03","moment":"crowd.hype","text":"Let's see it.","off":15483,"len":7473,"sec":0.896},{"id":"crowd.hype.04","moment":"crowd.hype","text":"Go on then.","off":22956,"len":7311,"sec":0.918},{"id":"crowd.ooh.01","moment":"crowd.ooh","text":"Okay, that's clean.","off":30267,"len":8771,"sec":1.308},{"id":"crowd.ooh.02","moment":"crowd.ooh","text":"Oh, respect.","off":39038,"len":8195,"sec":1.048},{"id":"crowd.ooh.03","moment":"crowd.ooh","text":"Nice handle!","off":47233,"len":7468,"sec":0.89},{"id":"crowd.cheer.01","moment":"crowd.cheer","text":"Yeah, that's cash.","off":54701,"len":8033,"sec":1.112},{"id":"crowd.cheer.02","moment":"crowd.cheer","text":"Can't guard that.","off":62734,"len":7876,"sec":1.012},{"id":"crowd.cheer.03","moment":"crowd.cheer","text":"Pure!","off":70610,"len":6152,"sec":0.614},{"id":"crowd.cheer.04","moment":"crowd.cheer","text":"That's a real bucket.","off":76762,"len":8735,"sec":1.242},{"id":"crowd.erupt.01","moment":"crowd.erupt","text":"Okay, I take it back!","off":85497,"len":9511,"sec":1.454},{"id":"crowd.erupt.02","moment":"crowd.erupt","text":"Nah, that's just unfair!","off":95008,"len":8991,"sec":1.443},{"id":"crowd.erupt.03","moment":"crowd.erupt","text":"I got next, never mind!","off":103999,"len":9288,"sec":1.473},{"id":"crowd.erupt.04","moment":"crowd.erupt","text":"Whoa! Whoa! Whoa!","off":113287,"len":7915,"sec":1.031},{"id":"crowd.groan.01","moment":"crowd.groan","text":"Had it, then didn't.","off":121202,"len":8420,"sec":1.169},{"id":"crowd.groan.02","moment":"crowd.groan","text":"Soft finish.","off":129622,"len":7487,"sec":0.965},{"id":"crowd.groan.03","moment":"crowd.groan","text":"Rushed it. Slow down.","off":137109,"len":8864,"sec":1.332},{"id":"crowd.heckle.01","moment":"crowd.heckle","text":"Too fancy. Keep it simple!","off":145973,"len":9546,"sec":1.496},{"id":"crowd.heckle.02","moment":"crowd.heckle","text":"Check the arc on that!","off":155519,"len":8771,"sec":1.258},{"id":"crowd.heckle.03","moment":"crowd.heckle","text":"Wrong shot. Wrong time.","off":164290,"len":8954,"sec":1.422},{"id":"crowd.idle.01","moment":"crowd.idle","text":"I got next. Anybody seen who's after me?","off":173244,"len":11737,"sec":2.285},{"id":"crowd.idle.02","moment":"crowd.idle","text":"Honestly? I'd have taken that.","off":184981,"len":9673,"sec":1.559},{"id":"crowd.idle.03","moment":"crowd.idle","text":"Everybody wants to dunk. Nobody boxes out.","off":194654,"len":12988,"sec":2.576},{"id":"crowd.idle.04","moment":"crowd.idle","text":"Watch the footwork, that's the whole thing.","off":207642,"len":10386,"sec":1.876},{"id":"crowd.idle.05","moment":"crowd.idle","text":"Nice court. Rims are a little tight.","off":218028,"len":10751,"sec":1.903},{"id":"crowd.defense.01","moment":"crowd.defense","text":"Stay in front!","off":228779,"len":7891,"sec":1.062}]}