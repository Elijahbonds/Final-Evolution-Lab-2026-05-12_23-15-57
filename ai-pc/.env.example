# Copy to .env and fill in. Never commit .env.

# Bearer token the agent API requires. Generate one:
#   openssl rand -hex 32
AGENT_TOKEN=

# Local model served by Ollama. model-init pulls this on first boot.
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# Frontier tier. Leave ANTHROPIC_API_KEY empty to run everything locally —
# frontier roles fall back to the local model and log one warning at startup.
ANTHROPIC_API_KEY=
FRONTIER_MODEL=claude-sonnet-4-6

# Host port for the agent console.
AGENT_PORT=8001

# Budgets.
MAX_STEPS=24
WALL_CLOCK_SECONDS=900
BASH_TIMEOUT_SECONDS=120
BROWSE_TIMEOUT_SECONDS=45
MAX_OUTPUT_CHARS=20000

# Only needed with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
