# Final Evolution Lab — environment template
# Copy to `.env` (git-ignored) and fill in. Only DATABASE_URL, NEXTAUTH_URL and
# NEXTAUTH_SECRET are required to boot; everything else degrades gracefully.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string. Schema is applied with `yarn db:push`
# (prisma/schema.prisma has no migrations folder — db push is the workflow).
DATABASE_URL="postgresql://user:password@localhost:5432/fel?schema=public"

# NextAuth. NEXTAUTH_URL must match the deployed origin exactly.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ── Build / runtime shape ─────────────────────────────────────────────────────

# "standalone" produces a self-contained server bundle for container deploys.
# Leave unset for a normal `next start` deploy.
NEXT_OUTPUT_MODE=""
# Override the build output directory (defaults to .next).
NEXT_DIST_DIR=""

# ── Payments (Stripe) — coin/shard packs. Unset = purchase routes disabled ────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_COINS_SMALL=""
STRIPE_PRICE_COINS_LARGE=""

# ── Object storage (S3-compatible) — avatar scans, replay clips, creator assets ─
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# ── Nexus engine gateway ──────────────────────────────────────────────────────
NEXUS_GATEWAY_URL=""
NEXT_PUBLIC_NEXUS_ENABLED="0"

# ── Coach / AI services ───────────────────────────────────────────────────────
ABACUSAI_API_KEY=""
WEB_APP_ID=""

# ── Challenge links (signed share URLs) ───────────────────────────────────────
# Generate with: openssl rand -hex 32
CHALLENGE_SIGN_SECRET=""

# ── Lifecycle email notification template ids (marketing/email.ts) ────────────
NOTIF_ID_WELCOME_EMAIL=""
NOTIF_ID_REFERRAL_REWARD=""
NOTIF_ID_NEW_LEAD_CAPTURED=""
NOTIF_ID_COME_BACK_PLAY=""

# ── Client feature flags (compiled into the browser bundle) ───────────────────
NEXT_PUBLIC_PROCEDURAL_CHARACTERS="0"
NEXT_PUBLIC_PREMIUM_DRESSING="0"
NEXT_PUBLIC_MOCAP_DUNK="0"
NEXT_PUBLIC_DUNK_FINISH_VARIETY="0"
# Exposes window.__felTest (getState/sendInput) for the self-playtest harness.
NEXT_PUBLIC_PLAYTEST_MODE="0"
