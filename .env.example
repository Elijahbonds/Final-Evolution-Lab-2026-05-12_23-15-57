# Final Evolution Lab — environment template
#
# Copy to `.env` for local development. In a deployment these are set on the
# hosting platform, NOT in a committed file.
#
# The two REQUIRED vars below are the ones that break sign-in when wrong. A
# deployment that inherits a local `127.0.0.1` value for either will start up
# and serve pages normally, then fail every login — verify after each deploy:
#
#   curl https://<your-domain>/api/health/db     -> {"ok":true,...}

# ---------------------------------------------------------------------------
# REQUIRED — sign-in does not work without these
# ---------------------------------------------------------------------------

# Postgres connection string. MUST be reachable from wherever the app runs.
# `127.0.0.1` / `localhost` is the container's own loopback in a deployment and
# will NOT reach a managed database — use the real host, or the Cloud SQL
# socket path, and keep sslmode as your provider requires.
DATABASE_URL="postgresql://user:password@host:5432/final_evolution_lab?schema=public"

# Public origin of the running app, scheme included, no trailing slash.
# NextAuth builds callback and redirect URLs from this: a localhost value in a
# deployment bounces athletes to a dead page after a successful login.
NEXTAUTH_URL="http://localhost:3000"

# Signing key for session JWTs. Generate with: openssl rand -base64 32
# Must be identical across every instance, and stable across deploys —
# rotating it signs every athlete out.
NEXTAUTH_SECRET=""

# ---------------------------------------------------------------------------
# OPTIONAL — features degrade gracefully when unset
# ---------------------------------------------------------------------------

# AI coach / generation
ABACUSAI_API_KEY=""
NEXUS_GATEWAY_URL=""

# Payments (store, Lab Credits)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_COINS_SMALL=""
STRIPE_PRICE_COINS_LARGE=""

# Asset storage
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# Transactional email / notifications
WEB_APP_ID=""
NOTIF_ID_WELCOME_EMAIL=""
NOTIF_ID_REFERRAL_REWARD=""
NOTIF_ID_NEW_LEAD_CAPTURED=""
NOTIF_ID_COME_BACK_PLAY=""

# Signed challenge links
CHALLENGE_SIGN_SECRET=""

# ---------------------------------------------------------------------------
# Client feature flags (NEXT_PUBLIC_* are inlined at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NEXUS_ENABLED=""
NEXT_PUBLIC_DISABLE_3D=""
NEXT_PUBLIC_PLAYTEST_MODE=""
NEXT_PUBLIC_PROCEDURAL_CHARACTERS=""
NEXT_PUBLIC_PROCEDURAL_ENVIRONMENTS=""
NEXT_PUBLIC_PREMIUM_DRESSING=""
NEXT_PUBLIC_MOCAP_DUNK=""
NEXT_PUBLIC_DUNK_FINISH_VARIETY=""
