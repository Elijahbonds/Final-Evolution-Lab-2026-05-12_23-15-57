// ===========================================================================
// M1 — Double-entry ledger foundation (additive; unifies LC + real money).
//   Convention: every LedgerTransaction has >= 2 postings whose signed
//   `amount` values sum to exactly 0 (sum(debits) == sum(credits)).
//   An account's balance = SUM(amount) over its postings.
//   Non-EXTERNAL account balances must stay >= 0.
// ===========================================================================

enum LedgerCurrency {
  LC            // virtual Lab Credits (soft currency)
  USD_CENTS     // real money, integer cents
  STUDIO_CREDIT // virtual prepaid NEXUS Studio build-overage unit (M3); isolated book
}

enum LedgerAccountType {
  USER_WALLET      // per-user spendable balance
  ESCROW           // funds held for an open match / contest
  PLATFORM_REVENUE // platform fees / cut
  CREATOR_ACCRUAL  // creator earnings awaiting payout
  EXTERNAL         // counterparty for value entering/leaving the system (mint/burn, Stripe, payouts)
}

model LedgerAccount {
  id        String            @id @default(cuid())
  type      LedgerAccountType
  currency  LedgerCurrency
  userId    String?           // set for USER_WALLET / CREATOR_ACCRUAL; null for system singletons
  scopeId   String?           // optional scope (e.g. matchId for ESCROW)
  key       String            @unique // canonical: "<TYPE>:<CURRENCY>[:<scope>]"
  createdAt DateTime          @default(now())

  postings  LedgerPosting[]

  @@index([type, currency])
  @@index([userId])
}

model LedgerTransaction {
  id             String          @id @default(cuid())
  kind           String          // reason/category, e.g. LESSON_COMPLETE, CARD_PURCHASE, STRIPE_SUBSCRIPTION
  idempotencyKey String          @unique
  currency       LedgerCurrency
  metadata       Json?
  createdAt      DateTime        @default(now())

  postings       LedgerPosting[]

  @@index([kind, createdAt])
}

model LedgerPosting {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  amount        Int               // signed; +credit / -debit; per-transaction postings sum to 0
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
}

// =====================================================================
// M2 — Track A Revenue (Stripe + marketplace + ladder)
// =====================================================================

enum SubscriptionProduct {
  FEL_PRO
  STUDIO_CREATOR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum OrderType {
  SUBSCRIPTION
  COSMETIC
  MARKETPLACE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model StripeCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id])
  stripeSubscriptionId String              @unique
  stripePriceId        String
  product              SubscriptionProduct
  status               SubscriptionStatus  @default(ACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, product])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  stripeSessionId String      @unique
  type            OrderType
  amount          Int         // in cents
  currency        String      @default("usd")
  status          OrderStatus @default(PENDING)
  itemKey         String?     // e.g. cosmetic key or marketplace listing id
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, type])
}

model PayoutRequest {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  amount           Int          // in cents
  currency         String       @default("usd")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  ledgerTxId       String?
  idempotencyKey   String       @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId, status])
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation("CreatorListings", fields: [creatorId], references: [id])
  title       String
  description String?
  itemKey     String   @unique  // unique content identifier
  priceUsd    Int      // in cents
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // M3 (Track C): listing type + cartridge manifest
  listingType String   @default("COSMETIC") // COSMETIC | CARTRIDGE
  version     String   @default("1.0.0")
  manifest    String   @default("")         // JSON CartridgeManifest (empty for COSMETIC)
  sourceProjectId String?                    // originating CellProject for a CARTRIDGE

  purchases   MarketplacePurchase[]

  @@index([creatorId])
  @@index([listingType, active])
}

// ─── M3 Track C — Studio Creator partner API ───

model StudioPartnerKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("PartnerKeys", fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("")
  keyHash     String   @unique // sha256 of the raw partner key; raw is shown once at creation
  keyHint     String   @default("") // e.g. "nxk_live_...ab12" for display
  scopes      String   @default("build:read") // comma-separated scopes
  active      Boolean  @default(true)
  monthlyQuota Int     @default(1000) // metered partner calls per billing month; -1 = unlimited
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  usages      PartnerUsage[]

  @@index([userId])
  @@index([active])
}

model PartnerUsage {
  id          String   @id @default(cuid())
  partnerKeyId String
  partnerKey  StudioPartnerKey @relation(fields: [partnerKeyId], references: [id], onDelete: Cascade)
  endpoint    String   @default("")
  units       Int      @default(1)   // billable units for this call
  costUsd     Float    @default(0)
  status      Int      @default(200) // HTTP status recorded
  billingMonth String  @default("")  // YYYY-MM for cheap monthly rollups
  createdAt   DateTime @default(now())

  @@index([partnerKeyId, createdAt])
  @@index([partnerKeyId, billingMonth])
}

model MarketplacePurchase {
  id         String   @id @default(cuid())
  buyerId    String
  buyer      User     @relation("BuyerPurchases", fields: [buyerId], references: [id])
  listingId  String
  listing    MarketplaceListing @relation(fields: [listingId], references: [id])
  orderId    String?
  ledgerTxId String?
  createdAt  DateTime @default(now())

  @@unique([buyerId, listingId])
  @@index([listingId])
}

model LadderSeason {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique  // Monday 00:00 UTC
  weekEnd    DateTime
  mode       String   @default("dunk")
  prizePool  Int      @default(500) // LC amount
  finalized  Boolean  @default(false)
  createdAt  DateTime @default(now())

  entries    LadderEntry[]
}

model LadderEntry {
  id        String       @id @default(cuid())
  seasonId  String
  season    LadderSeason @relation(fields: [seasonId], references: [id])
  userId    String
  user      User         @relation("LadderEntries", fields: [userId], references: [id])
  score     Int          @default(0)
  attempts  Int          @default(0)
  bestScore Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([seasonId, userId])
  @@index([seasonId, bestScore])
}

// ─── M4 Track B — Real-money competition ───

model CompetitionMatch {
  id           String   @id @default(cuid())
  mode         String   // game mode key, e.g. "dunkContest"
  matchType    String   @default("H2H") // H2H | SCORE_DUEL | GHOST_DUEL
  status       String   @default("WAITING") // WAITING | ACTIVE | SCORED | SETTLED | DISPUTED | VOIDED | EXPIRED
  // M14 Triumph Arena: which currency book this match settles in.
  //   LC        = virtual Lab Credits (skill competition, no cash on-ramp, always live)
  //   USD_CENTS = real-money (DARK, flag-gated by REAL_MONEY_COMPETITION)
  currency     String   @default("USD_CENTS")
  entryFeeCents Int     @default(0)   // per-player entry fee (USD cents for real-money; LC units for Arena)
  rakePercent  Int      @default(10)  // platform rake percentage (e.g. 10 = 10%)
  seed         String?  // deterministic RNG seed (hex) for skill-game compliance

  player1Id    String
  player1      User     @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player1Score Int?
  player1SubmittedAt DateTime?

  player2Id    String?
  player2      User?    @relation("MatchPlayer2", fields: [player2Id], references: [id])
  player2Score Int?
  player2SubmittedAt DateTime?

  winnerId     String?
  winner       User?    @relation("MatchWinner", fields: [winnerId], references: [id])

  escrowTxId   String?  // ledger transaction ID for escrow lock
  settleTxId   String?  // ledger transaction ID for settlement
  refundTxId   String?  // ledger transaction ID for refund (dispute/void)

  // Async score-duel: deadline for both players to submit
  expiresAt    DateTime?
  disputeReason String?
  disputedAt   DateTime?
  disputedBy   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       MatchEvent[]

  @@index([status])
  @@index([player1Id])
  @@index([player2Id])
  @@index([matchType, status])
  @@index([currency, status, mode])
}

model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     CompetitionMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seq       Int      @default(0)
  eventType String   // CREATED | JOINED | ESCROW_LOCKED | SCORE_SUBMITTED | SETTLED | DISPUTED | VOIDED | REFUNDED | EXPIRED
  userId    String?  // who triggered the event (null for system events like EXPIRED)
  user      User?    @relation(fields: [userId], references: [id])
  payload   String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([matchId, seq])
}

// Mirror Triumph — free tier beat-your-own-ghost streaks
model MirrorTriumph {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         String   // game mode key
  bestScore    Int      @default(0)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  totalBeats   Int      @default(0) // total times the user beat their ghost
  lastBeatAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, mode])
  @@index([userId])
}

// Task 3 — PRQ / Digital-Twin Foundation: honest, sourced attribute entries.
// Every value knows where it came from (source) and when it was measured.
// source: manual = user-reported, device = connected device (seam only in v1),
//         drillResult = computed from a game/drill session.
model PrqEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute   String   // PRQ attribute key (strength, speed, etc.)
  value       Float    // measured / reported numeric value
  unit        String   // unit of measurement (e.g. "in", "sec", "lbs", "score")
  source      String   // manual | device | drillResult
  sessionId   String?  // link to GameSession if source=drillResult
  measuredAt  DateTime // when the measurement was taken
  createdAt   DateTime @default(now())

  @@index([userId, attribute, measuredAt])
  @@index([userId, createdAt])
}

// ===========================================================================
// M13 — Foundation for a Classic (guest mode, seasons, mastery, challenge
// links, analytics). All additive; server owns all grants and scores.
// ===========================================================================

// --- Guest mode (Blueprint 2.1) -------------------------------------------
// Server-issued anonymous session so the landing page can reach a judged dunk
// with zero auth. Carries NO PII (M13 FIREWALL). `data` holds the scripted
// taste-run PRQ snapshot that migrates into the account on claim.
model GuestSession {
  id             String   @id @default(cuid())
  token          String   @unique
  data           Json?    // taste-run state (scores/cards) migrated on claim
  migratedUserId String?  // set when the guest converts to a real account
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([migratedUserId])
}

// --- Season engine (Blueprint 2.3) ----------------------------------------
// Season CONTENT (rewards) is data (Json), so future seasons ship without
// deploys. Only one season is `active` at a time.
model Season {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "S1"
  name      String            // e.g. "Golden Hour"
  theme     String?           // cosmetic theme tag
  tiers     Int      @default(50)
  rewards   Json?             // per-tier reward table (data, not code)
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  progress  PassProgress[]
  grants    PassGrant[]
}

// Per-user pass state for a season. XP from ANY mode advances tiers.
model PassProgress {
  id          String   @id @default(cuid())
  userId      String
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  xp          Int      @default(0) // XP into current tier
  tier        Int      @default(0)
  hasPro      Boolean  @default(false)
  claimedFree Json?    // array of claimed FREE-lane tier numbers
  claimedPro  Json?    // array of claimed PRO-lane tier numbers
  updatedAt   DateTime @updatedAt

  @@unique([userId, seasonId])
  @@index([userId])
}

// Idempotent grant log (ledger-keyed like LC). One row per (user, dedupeKey).
model PassGrant {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tier      Int
  lane      String   // "free" | "pro"
  reward    Json     // the granted reward descriptor
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  @@index([userId, seasonId])
}

// --- Mastery ladder (Blueprint 2.2) ---------------------------------------
// Per-mode graded ladder. Rolling window of samples in Json; tier never
// decays below earned.
model ModeMastery {
  id        String   @id @default(cuid())
  userId    String
  mode      String
  samples   Json     // number[] rolling window (max 10)
  tier      Int      @default(0) // 0 = Unranked, 1..5 = Bronze..Venice Legend
  updatedAt DateTime @updatedAt

  @@unique([userId, mode])
  @@index([userId])
}

// Weekly seeded Signature Challenge attempt (one per user per challenge per day).
model SignatureAttempt {
  id           String   @id @default(cuid())
  userId       String
  mode         String
  challengeKey String   // seeded weekly key, e.g. "dunkContest:2026-W29"
  score        Int
  createdAt    DateTime @default(now())

  @@index([mode, challengeKey, score])
  @@index([userId, challengeKey])
}

// --- Challenge links (Blueprint 2.4) — the K-factor engine ----------------
// Server signs + stamps the payload; funnel counters instrument the loop.
model ChallengeLink {
  id          String   @id @default(cuid())
  code        String   @unique // base64url payload id (short hash)
  ownerUserId String?          // null if minted by a guest
  modeKey     String
  score       Int
  display     String?
  tag         String
  payload     Json             // signed ChallengePayload
  sig         String           // HMAC signature
  opened      Int      @default(0)
  attempted   Int      @default(0)
  beaten      Int      @default(0)
  signups     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
  @@index([modeKey])
}

// --- Analytics pipeline (Blueprint Part 3) --------------------------------
// First-party only, no third-party trackers. Telemetry only — never carries
// credit amounts or PRQ deltas (those are server-authoritative elsewhere).
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  props      Json?
  sessionKey String?           // groups a browsing session
  userId     String?           // null for guests
  guestId    String?           // GuestSession token when unauthenticated
  ts         DateTime          // client wall-clock
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@index([userId])
}

// Daily rollup of the funnel/retention metrics for /admin/metrics.
model MetricRollup {
  id        String   @id @default(cuid())
  day       String   @unique // YYYY-MM-DD (UTC)
  payload   Json     // { dau, newUsers, d1, d7, d30, kFactor, conv, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================================
// FEL — Server-Authoritative Dual-Currency Wallet (coins / shards)
// Distinct from the LC CreditLedger and the double-entry LedgerAccount books.
//   coins  = high-volume grind currency, purchasable (Stripe -> coins ONLY)
//   shards = low-volume prestige currency, milestone-earned, NEVER purchasable
// Balances are reconstructable from WalletLedgerEntry alone (audit trail).
// Non-negativity is enforced by conditional atomic decrement in the service
// layer AND by DB CHECK constraints applied post-push (see prisma/wallet-constraints.sql).
// =====================================================================

enum WalletCurrency {
  coins
  shards
}

enum WalletLedgerSource {
  gameplay
  milestone
  purchase
  spend
  admin_adjust
  refund
}

model Wallet {
  id        String   @id @default(cuid())
  playerId  String   @unique
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coins     BigInt   @default(0) // CHECK >= 0 (applied via wallet-constraints.sql)
  shards    BigInt   @default(0) // CHECK >= 0
  version   BigInt   @default(0) // optimistic-concurrency counter
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   WalletLedgerEntry[]

  @@index([playerId])
}

model WalletLedgerEntry {
  id             String             @id @default(cuid())
  walletId       String
  wallet         Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency       WalletCurrency
  delta          BigInt             // signed; negative = spend
  balanceAfter   BigInt             // snapshot for audit
  reasonCode     String             // see lib/wallet/reward-rules.ts
  source         WalletLedgerSource
  idempotencyKey String             @unique
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([walletId, createdAt])
  @@index([reasonCode])
  @@index([createdAt])
}

// Server-side reward config. Editable at runtime (no client release, no deploy).
model RewardRule {
  id                 String         @id @default(cuid())
  reasonCode         String         @unique
  currency           WalletCurrency
  formula            String         @default("flat") // flat | scoreLinear
  baseAmount         Int            @default(0)
  scaleNum           Float          @default(0)      // multiplier input for scoreLinear
  minGrant           Int            @default(0)
  maxGrant           Int            @default(0)
  perMinuteCap       Int            @default(0)       // 0 = no per-minute cap
  perDayCurrencyCap  Int            @default(0)       // 0 = no rolling-24h currency cap
  active             Boolean        @default(true)
  updatedAt          DateTime       @updatedAt
  createdAt          DateTime       @default(now())
}

// Raw client-reported performance events. Retained even when rejected — this
// is the anti-cheat + tuning dataset.
model PerfEarnEvent {
  id              String   @id @default(cuid())
  playerId        String
  player          User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json
  payloadHash     String   // for replay detection
  resolvedEntryId String?  // WalletLedgerEntry.id this produced, if any
  rejectedReason  String?  // set when validation failed
  createdAt       DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([playerId, payloadHash, createdAt])
}

// Grant-on-purchase / grant-on-spend unlocks (minimal; no catalog UI).
model PlayerEntitlement {
  id        String   @id @default(cuid())
  playerId  String
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skuId     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, skuId])
  @@index([playerId])
}

// ===========================================================================
// SECOND-PASS SYSTEMS — marketing funnel, referral loop, async multiplayer,
// creator cards. All additive; existing models untouched.
// ===========================================================================

enum FunnelStage {
  lead        // captured email, not yet engaged
  welcomed    // welcome email sent
  activated   // played at least one session
  converted   // created a full account
  dormant     // went inactive after engaging
}

model MarketingLead {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String?
  source          String      @default("landing") // landing | signup | referral | import
  stage           FunnelStage @default(lead)
  welcomeEmailAt  DateTime?
  reengagedAt     DateTime?
  referredByCode  String?     // ReferralCode.code that sent this lead
  ipHash          String?
  convertedUserId String?     @unique
  convertedUser   User?       @relation("LeadConversion", fields: [convertedUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastSeenAt      DateTime    @default(now())

  @@index([stage])
  @@index([createdAt])
}

model ReferralCode {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation("UserReferralCode", fields: [userId], references: [id], onDelete: Cascade)
  code        String   @unique
  clicks      Int      @default(0)
  signups     Int      @default(0)
  createdAt   DateTime @default(now())
  conversions ReferralConversion[]
}

model ReferralConversion {
  id             String       @id @default(cuid())
  codeId         String
  code           ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrerId     String
  referredUserId String       @unique
  shardsAwarded  Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([referrerId])
}

// --- Async multiplayer (challenge / PvP; NOT realtime) ---------------------
enum MpStatus {
  open        // host posted a score, awaiting a challenger
  pending     // guest joined, awaiting their play
  settled     // both played, winner resolved
  expired     // timed out with no challenger
}

enum MpKind {
  online      // asynchronous online challenge between two accounts
  local       // pass-and-play on one device (both slots same account)
}

model MpMatch {
  id           String    @id @default(cuid())
  mode         String    // game mode key (e.g. "sprint", "threepoint")
  kind         MpKind    @default(online)
  status       MpStatus  @default(open)
  code         String    @unique // short shareable challenge code

  hostId       String
  host         User      @relation("MpHost", fields: [hostId], references: [id], onDelete: Cascade)
  hostName     String
  hostScore    Int?
  hostPlayedAt DateTime?

  guestId      String?
  guest        User?     @relation("MpGuest", fields: [guestId], references: [id], onDelete: SetNull)
  guestName    String?
  guestScore   Int?
  guestPlayedAt DateTime?

  winnerId     String?   // resolved user id, or null for a draw/unsettled
  rewarded     Boolean   @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime?

  @@index([status])
  @@index([mode])
  @@index([hostId])
  @@index([guestId])
}

// --- Creator cards ---------------------------------------------------------
// ── M28 Creative Modes — five-discipline UGC card (art/music/dance/acting/sport) ──
// Distinct from the athlete-identity CreatorCard above. Additive only.
model CreativeCard {
  id               String   @id
  ownerId          String
  title            String
  primary          String   // Discipline: sport|music|art|dance|acting
  secondary        String[] // up to 2 secondary disciplines
  sportDesignation String?  // required when sport is primary/secondary
  art              Json     // ArtPayload (discriminated union keyed by discipline)
  stats            Json     // CardStats
  rarityTier       String   @default("common")
  rarityMult       Float    @default(1.0)
  isPublic         Boolean  @default(false)
  remixOf          String?  // parent card id — powers the remix graph
  licenseAccepted  Boolean  @default(false)
  reviewState      String   @default("approved") // approved|pending_review|rejected
  createdAt        DateTime @default(now())

  owner            User     @relation("UserCreativeCards", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([primary, isPublic, reviewState])
  @@index([remixOf])
}

model CardSlot {
  userId String @id
  extra  Int    @default(0)
  user   User   @relation("UserCardSlot", fields: [userId], references: [id], onDelete: Cascade)
}

enum CreatorCardRarity {
  common
  rare
  epic
  legendary
}

model CreatorCard {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation("CreatorCards", fields: [ownerId], references: [id], onDelete: Cascade)
  slug        String            @unique // shareable public handle
  displayName String
  tagline     String?
  mode        String            @default("dunk") // signature mode
  rarity      CreatorCardRarity @default(common)
  accent      String            @default("#00E5FF") // hex accent color
  avatarUrl   String?

  // Snapshot stats (denormalized for fast card render)
  prq         Int               @default(0)
  topScore    Int               @default(0)
  wins        Int               @default(0)
  signatureMove String?

  published   Boolean           @default(false)
  views       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
  @@index([published])
}

// ===========================================================================
// M17 — Personalized Workout + Mini-Avatar (scan -> movement screen -> plan)
// Raw video NEVER stored; only a keypoint timeline + derived metrics.
// ===========================================================================
model WorkoutScan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   @default("movement_screen") // movement_screen|jump|run|dunk|freestyle
  // Derived movement-screen metrics (numbers only — privacy safe).
  metrics     Json     // { jumpHeightCm, depthDeg, asymmetryPct, valgusL, valgusR, cadenceSpm, ... }
  avatarSpec  Json?    // proportions + palette produced by avatarBuilder
  createdAt   DateTime @default(now())

  plans       WorkoutPlan[]

  @@index([userId])
}

model WorkoutPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId      String?
  scan        WorkoutScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  tier        String   @default("plan_4w") // plan_4w | program_12w
  weeks       Json     // generated plan structure
  focus       String   @default("") // primary focus derived from weakest metric
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ===========================================================================
// M20 — The Closet (avatar identity: face + wearables + creator-card skins)
// ===========================================================================
model AvatarLook {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  face        Json     // FaceConfig: skinTone, faceShape, hairStyle, hairColor, eyeShape, eyeColor, brows, mouth, nose
  equipped    Json     // { headwear, tops, shorts, shoes, accessory } -> itemId|null
  skinCardId  String?  // applied creator-card skin (ownership verified server-side)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model OwnedWearable {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  acquiredAt  DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

// ===========================================================================
// M21 — Group Sessions + Booking (paid with shards; server-gated join)
// ===========================================================================
model SessionBooking {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   // group_workout | seminar | private_1on1
  sessionKey  String   // schedule slot id (from sessionSchedule config) or booking slot
  status      String   @default("confirmed") // confirmed | cancelled | refunded | pending
  shardsPaid  Int      @default(0)
  startsAt    DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([sessionKey])
}

// ===========================================================================
// CRM — Contacts, Companies, Deals, Activities, Notes
// ===========================================================================

enum CrmDealStage {
  lead
  qualified
  proposal
  negotiation
  closed_won
  closed_lost
}

enum CrmActivityKind {
  call
  email
  meeting
  task
  note
}

enum CrmActivityStatus {
  pending
  completed
  cancelled
}

model CrmCompany {
  id          String   @id @default(cuid())
  name        String
  domain      String?  // website domain
  industry    String?
  size        String?  // 1-10, 11-50, 51-200, 201-500, 500+
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts    CrmContact[]
  deals       CrmDeal[]

  @@index([name])
}

model CrmContact {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String?  @unique
  phone         String?
  title         String?  // job title
  source        String   @default("manual") // manual | import | signup | lead
  linkedUserId  String?  // linked FEL User if applicable
  linkedUser    User?    @relation("CrmContactLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  companyId     String?
  company       CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId       String?  // assigned sales rep (User.id)
  owner         User?    @relation("CrmContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tags          String?  // comma-separated tags
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deals         CrmDeal[]
  activities    CrmActivity[]
  crmNotes      CrmNote[]

  @@index([ownerId])
  @@index([companyId])
  @@index([lastName, firstName])
}

model CrmDeal {
  id          String        @id @default(cuid())
  title       String
  value       Float         @default(0) // deal value in dollars
  stage       CrmDealStage  @default(lead)
  probability Int           @default(0) // 0-100 close probability
  closeDate   DateTime?     // expected close date
  description String?

  contactId   String?
  contact     CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId   String?
  company     CrmCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId     String?       // assigned sales rep
  owner       User?         @relation("CrmDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  activities  CrmActivity[]
  crmNotes    CrmNote[]

  @@index([stage])
  @@index([ownerId])
  @@index([contactId])
}

model CrmActivity {
  id          String            @id @default(cuid())
  kind        CrmActivityKind   @default(task)
  title       String
  description String?
  status      CrmActivityStatus @default(pending)
  dueDate     DateTime?

  contactId   String?
  contact     CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId      String?
  deal        CrmDeal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)

  ownerId     String?           // assigned to
  owner       User?             @relation("CrmActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
  @@index([contactId])
  @@index([dealId])
  @@index([dueDate])
  @@index([status])
}

model CrmNote {
  id          String   @id @default(cuid())
  content     String

  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dealId      String?
  deal        CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contactId])
  @@index([dealId])
}
